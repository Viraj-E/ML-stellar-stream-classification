#!/usr/bin/env bash
#PBS -P YOUR_PROJECT
#PBS -q gpuvolta
#PBS -l walltime=01:30:00
#PBS -l mem=191GB
#PBS -l ncpus=24
#PBS -l ngpus=2
#PBS -N xgboost_infer
#PBS -j oe

set -euo pipefail

REPO_DIR="/path/to/stellar-stream-classification"
INPUT_H5="/path/to/snapshot.hdf5"
CHECKPOINT="/path/to/stream_classifier.json"
METADATA="/path/to/feature_metadata.json"
OUT_DIR="/path/to/outputs/XGBoost"
ENV_DIR="/path/to/xgboost_gpu_env"

module purge
module load python3/3.10.0 cuda/12.9.0 gsl/2.7.1 openmpi/5.0.5
module load binutils/2.43 hdf5/1.12.2 hwloc/2.11.2 gcc/13.2.0 fftw3/3.3.10

export CUDA_VISIBLE_DEVICES=0,1
source "${ENV_DIR}/bin/activate"

mkdir -p "${OUT_DIR}"
cd "${REPO_DIR}"

python XGBoost/xgboost.py infer "${INPUT_H5}" \
  --ckpt_path "${CHECKPOINT}" \
  --meta_path "${METADATA}" \
  --out_dir "${OUT_DIR}" \
  --infer_chunk_size 40000
